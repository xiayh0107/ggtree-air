{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggtree-air.local/schemas/scene.schema.json",
  "title": "ggtree-air semantic scene",
  "type": "object",
  "required": ["schema_version", "created", "scene_id", "tree", "views"],
  "properties": {
    "schema_version": {"const": "1.2.0"},
    "created": {"type": "string"},
    "scene_id": {"type": "string", "pattern": "^tree:[0-9a-f]{32}$"},
    "tree": {
      "type": "object",
      "required": ["hash", "tips", "internal_nodes", "rooted", "input"],
      "properties": {
        "hash": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "tips": {"type": "integer", "minimum": 2},
        "internal_nodes": {"type": "integer", "minimum": 1},
        "rooted": {"type": "boolean"},
        "input": {"type": "object"}
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layout", "coordinate_system", "bounds", "nodes", "edges", "artifact_regions"],
        "properties": {
          "id": {"type": "string"},
          "layout": {"type": "string"},
          "variant": {"enum": ["base", "intents", "annotated"]},
          "coordinate_system": {"type": "string"},
          "bounds": {"type": "object"},
          "panel_region": {
            "type": "object",
            "required": ["left", "top", "width", "height"]
          },
          "artifact": {"type": ["object", "null"]},
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "node", "parent", "kind", "coordinate", "selector"],
              "properties": {
                "id": {"type": "string"},
                "node": {"type": "integer"},
                "parent": {"type": "integer"},
                "kind": {"enum": ["tip", "internal_node"]},
                "label": {"type": ["string", "null"]},
                "group": {"type": ["string", "null"]},
                "support": {"type": ["number", "string", "null"]},
                "coordinate": {"type": "object"},
                "artifact_coordinate": {"type": "object"},
                "selector": {"type": "object"}
              }
            }
          },
          "edges": {"type": "array"},
          "artifact_regions": {"type": "array"}
        }
      }
    }
  }
}
