{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggtree-air.local/schemas/workspace.schema.json",
  "title": "ggtree-air workspace",
  "type": "object",
  "required": ["schema_version", "id", "created", "updated", "revision", "status", "spec"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string"},
    "kind": {"enum": ["artifact-canvas", "phylogeny-render"]},
    "created": {"type": "string"},
    "updated": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "next_revision": {"type": "integer", "minimum": 2},
    "current_branch": {"type": "string"},
    "branches": {"type": "object"},
    "revisions": {"type": "object"},
    "status": {"enum": ["ready", "running", "error"]},
    "spec": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "kind": {"enum": ["artifact-canvas", "phylogeny-render"]},
        "tree": {"type": ["string", "null"]},
        "dist": {"type": ["string", "null"]},
        "fasta": {"type": ["string", "null"]},
        "groups": {"type": ["string", "null"]},
        "layouts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "intents": {"type": "array", "items": {"type": "string"}},
        "render": {"type": "object"},
        "title": {"type": "string"}
      }
    }
  }
}
