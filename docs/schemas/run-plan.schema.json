{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ggtree-air.local/schemas/run-plan.schema.json",
  "title": "ggtree-air bounded next-run plan",
  "type": "object",
  "required": ["base_revision", "operations"],
  "properties": {
    "base_revision": {"type": "integer", "minimum": 1},
    "rationale": {"type": "string", "maxLength": 8000},
    "feedback_ids": {"type": "array", "maxItems": 200, "items": {"type": "string"}},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {"type": "object", "required": ["op", "values"], "properties": {"op": {"const": "set-layouts"}, "values": {"type": "array", "items": {"type": "string"}}}},
          {"type": "object", "required": ["op", "values"], "properties": {"op": {"const": "set-intents"}, "values": {"type": "array", "items": {"type": "string"}}}},
          {"type": "object", "required": ["op", "value"], "properties": {"op": {"const": "set-tip-labels"}, "value": {"enum": ["auto", "show", "hide"]}}},
          {"type": "object", "required": ["op", "values"], "properties": {"op": {"const": "set-heatmap-columns"}, "values": {"type": "array", "items": {"type": "string"}}}},
          {"type": "object", "required": ["op", "value"], "properties": {"op": {"const": "set-heatmap-width"}, "value": {"type": "number", "minimum": 0.05, "maximum": 0.6}, "layout": {"type": "string"}}},
          {"type": "object", "required": ["op", "value"], "properties": {"op": {"const": "set-palette"}, "value": {"enum": ["colorblind", "viridis", "pastel", "vivid", "warm", "cool", "monochrome"]}, "layout": {"type": "string"}}},
          {"type": "object", "required": ["op", "value"], "properties": {"op": {"const": "set-theme"}, "value": {"enum": ["publication", "minimal", "compact"]}, "layout": {"type": "string"}}},
          {"type": "object", "required": ["op", "node", "label"], "properties": {"op": {"const": "add-clade"}, "node": {"type": "integer"}, "label": {"type": "string"}}},
          {"type": "object", "required": ["op", "node"], "properties": {"op": {"const": "remove-clade"}, "node": {"type": "integer"}}}
        ]
      }
    }
  }
}
